{
  "rules": {
    ".read": false,
    ".write": false,
    "shared_groups": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "admin_broadcast": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'parthkrishnadas700@gmail.com'"
    },
    "user_telemetry": {
      ".read": "auth != null && auth.token.email == 'parthkrishnadas700@gmail.com'",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "app_config": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "banned_users": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
